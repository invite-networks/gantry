#!/bin/sh
# Appends every line to ./got and answers each request that has an id.
# allocate gets the address in ./answer, or an error when there is none.
while IFS= read -r line; do
  printf '%s\n' "$line" >> got
  id=$(printf '%s' "$line" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')
  [ -n "$id" ] || continue
  case $line in
    *'"type":"allocate"'*)
      if [ -s answer ]; then
        printf '{"id":%s,"ok":true,"result":{"address":"%s"}}\n' "$id" "$(cat answer)"
      else
        printf '{"id":%s,"ok":false,"error":"no address to give"}\n' "$id"
      fi ;;
    *) printf '{"id":%s,"ok":true}\n' "$id" ;;
  esac
done
