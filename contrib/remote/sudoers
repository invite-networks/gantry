# Installed by the gantry package as /etc/sudoers.d/gantry.

# Remote control: the gantry-remote account may run gantry-run as root,
# and nothing else. gantry-run accepts only projects in root-owned
# /etc/gantry/<name> directories and a fixed set of commands.
Defaults:gantry-remote env_reset, !requiretty
gantry-remote ALL=(root) NOPASSWD: /usr/libexec/gantry/gantry-run

# People in the gantry group may run gantry as root without a password.
# gantry runs itself through sudo for them, so they never type it. The
# environment is kept (sudo still removes its unsafe variables and sets
# secure_path) so compose interpolation sees the caller's variables.
# Membership is equivalent to root, as it is for the docker group.
Defaults:%gantry !env_reset
%gantry ALL=(root) NOPASSWD: /usr/bin/gantry
