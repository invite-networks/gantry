# Brings a Gantry project up at boot and down at shutdown. The project is
# found by name in the directories listed in /etc/gantry/project-dirs
# (for example /etc/gantry/<name>/ or /mnt/<storage>/<name>/). Then:
#   systemctl enable --now gantry@<name>
[Unit]
Description=Gantry project %i
# remote-fs.target: projects may live on NFS, next to their data.
Wants=network-online.target remote-fs.target
After=network-online.target remote-fs.target docker.service podman.socket kiri.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env gantry --installed %i up -d --wait
ExecStop=/usr/bin/env gantry --installed %i down
TimeoutStartSec=600
SyslogIdentifier=gantry-%i

[Install]
WantedBy=multi-user.target
