# Brings a Gantry project up at boot and down at shutdown.
# Put the project in /etc/gantry/<name>/gantry.yaml (or make
# /etc/gantry/<name> a symlink to the project's directory), then:
#   systemctl enable --now gantry@<name>
[Unit]
Description=Gantry project %i
# remote-fs.target: projects may live on NFS, next to their data.
Wants=network-online.target remote-fs.target
After=network-online.target remote-fs.target docker.service podman.socket kiri.service
ConditionPathIsDirectory=/etc/gantry/%i

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/gantry/%i
ExecStart=/usr/bin/env gantry up -d --wait
ExecStop=/usr/bin/env gantry down
TimeoutStartSec=600
SyslogIdentifier=gantry-%i

[Install]
WantedBy=multi-user.target
