# The host's long running watcher. Health: acts on containers that turn
# unhealthy whose service sets `health_on_failure: restart` or `stop`
# (engines only mark them; restart policies cover exits only). Pod
# certificates: mints them again before they run out or when the issuer's
# credential is renewed, and reports problems.
#
# One of each runs per host (/run/gantry/heal.lock, /run/gantry/tls.lock).
# gantry-agent runs both itself; it takes over with
# `systemctl disable --now gantry-supervise.service`.
[Unit]
Description=Gantry health and certificate watcher
After=docker.service kiri.service gantry-boot.service

[Service]
Type=simple
ExecStart=/usr/bin/gantry supervise
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
