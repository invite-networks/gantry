# Keeps pod certificates (pod.tls) fresh: mints them again past two thirds
# of their life or when the issuer's credential is renewed, rewrites each
# service's files, runs its on_renew, and reports problems.
#
# One watcher runs per host (it holds /run/gantry/tls.lock). It is separate
# from gantry-supervise, so a host whose health watcher is gantry-agent
# still keeps its certificates fresh. On a host with no pod certificates it
# only wakes once a minute to look.
[Unit]
Description=Gantry pod certificate watcher
After=docker.service kiri.service gantry-boot.service

[Service]
Type=simple
ExecStart=/usr/bin/gantry internal tls-watch
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
