# Brings a kirisame project up at boot and down at shutdown.
# Put the project in /etc/kirisame/<name>/kirisame.yaml, then:
#   systemctl enable --now kirisame@<name>
[Unit]
Description=kirisame project %i
Wants=network-online.target
After=network-online.target docker.service kiri.service
ConditionPathIsDirectory=/etc/kirisame/%i

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/kirisame/%i
ExecStart=/usr/local/bin/kirisame up -d --wait
ExecStop=/usr/local/bin/kirisame down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
