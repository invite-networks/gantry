+    fn uts_and_ipc_modes_take_an_absolute_namespace_path() {
+        let host = json!({"UTSMode": "ns:/run/pod/uts", "IpcMode": "ns:/run/pod/ipc"});
+        assert_eq!(ns_path_mode(&host, "UTSMode").unwrap(), "ns:/run/pod/uts");
+        assert_eq!(ns_path_mode(&host, "IpcMode").unwrap(), "ns:/run/pod/ipc");
+        // Not given, or a mode Kiri does not share: the container's own, as before.
+        for host in [json!({}), json!({"UTSMode": ""}), json!({"UTSMode": "host"}), json!({"UTSMode": null})] {
+            assert_eq!(ns_path_mode(&host, "UTSMode").unwrap(), "");
+        }
+        match ns_path_mode(&json!({"IpcMode": "ns:run/pod/ipc"}), "IpcMode") {
+            Err(Error::BadRequest(m)) => assert_eq!(m, "Invalid IpcMode: invalid namespace format ns:<absolute path>"),
+            other => panic!("{other:?}"),
+        }
+        assert!(ns_path_mode(&json!({"UTSMode": "ns:"}), "UTSMode").is_err());
+    }
