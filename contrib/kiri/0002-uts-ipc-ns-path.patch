-/// `--network ns:<path>`: a network namespace someone else made and keeps
-/// (`ip netns add`, a pod manager). It must be an absolute path to a
-/// network namespace, checked here so a wrong one fails with its path
-/// rather than as the child's "join network container: Invalid argument".
-fn open_netns_path(path: &str) -> io::Result<fs::File> {
+/// `--network`, `--uts` or `--ipc ns:<path>`: a namespace someone else made
+/// and keeps (`ip netns add`, a pod manager). It must be an absolute path to
+/// a namespace of that type (`CLONE_NEWNET`, `CLONE_NEWUTS`, `CLONE_NEWIPC`),
+/// checked here so a wrong one fails with its path rather than as the
+/// child's "join network container: Invalid argument".
+fn open_ns_path(path: &str, nstype: libc::c_int) -> io::Result<fs::File> {
     const NS_GET_NSTYPE: libc::c_ulong = 0xb703; // _IO(0xb7, 0x3)
-    let fail = |what: String| io::Error::new(io::ErrorKind::InvalidInput, format!("network namespace {path}: {what}"));
+    let (a, name) = match nstype {
+        libc::CLONE_NEWUTS => ("a", "UTS"),
+        libc::CLONE_NEWIPC => ("an", "IPC"),
+        _ => ("a", "network"),
+    };
+    let fail = |what: String| io::Error::new(io::ErrorKind::InvalidInput, format!("{name} namespace {path}: {what}"));
     if !path.starts_with('/') {
         return Err(fail("not an absolute path".into()));
     }
-    let f = fs::File::open(path).map_err(|e| io::Error::new(e.kind(), format!("network namespace {path}: {e}")))?;
+    let f = fs::File::open(path).map_err(|e| io::Error::new(e.kind(), format!("{name} namespace {path}: {e}")))?;
     // SAFETY: an ioctl without arguments on a file we own.
     let kind = unsafe { libc::ioctl(f.as_raw_fd(), NS_GET_NSTYPE as _) };
-    if kind != libc::CLONE_NEWNET {
-        return Err(fail("not a network namespace".into()));
+    if kind != nstype {
+        return Err(fail(format!("not {a} {name} namespace")));
     }
     Ok(f)
 }
 
+/// The hostname set in a UTS namespace the container joins: /proc/sys
+/// shows the calling task's, so the agent steps in to read it and back out,
+/// as it does for sysctls.
+fn ns_hostname(ns: &fs::File) -> io::Result<String> {
+    let own = fs::File::open("/proc/self/ns/uts")?;
+    sys::setns(ns.as_raw_fd(), libc::CLONE_NEWUTS)?;
+    let name = fs::read_to_string("/proc/sys/kernel/hostname");
+    // Coming back must work, or the agent itself has the container's hostname.
+    if let Err(e) = sys::setns(own.as_raw_fd(), libc::CLONE_NEWUTS) {
+        eprintln!("kiri-init: cannot leave a container's UTS namespace: {e}");
+        std::process::abort();
+    }
+    Ok(name?.trim_end().to_owned())
+}
+
 fn netns_inode(f: &fs::File) -> u64 {
     use std::os::unix::fs::MetadataExt;
     f.metadata().map_or(0, |m| m.ino())
@@ -725,6 +768,8 @@ fn prepare(argv: StrList<'_>, env: StrList<'_>, cwd: &str, user: &str, hostname:
         hostname: hostname.map(|h| h.as_bytes().to_vec()),
         domainname: None,
         net_join: None,
+        uts_join: None,
+        ipc_join: None,
         etc_files: Vec::new(),
         mounts: Vec::new(),
         net_ready: None,
@@ -1091,6 +1136,13 @@ fn container_child(p: &Prepared, rootfs: &CStr, io: &ChildStdio) -> ! {
     if let Some(ns) = &p.net_join {
         sys::setns(ns.as_raw_fd(), libc::CLONE_NEWNET).unwrap_or_else(|e| fail("join network container", e));
     }
+    // Before the mounts: /dev/mqueue belongs to the IPC namespace it is made in.
+    if let Some(ns) = &p.uts_join {
+        sys::setns(ns.as_raw_fd(), libc::CLONE_NEWUTS).unwrap_or_else(|e| fail("join UTS namespace", e));
+    }
+    if let Some(ns) = &p.ipc_join {
+        sys::setns(ns.as_raw_fd(), libc::CLONE_NEWIPC).unwrap_or_else(|e| fail("join IPC namespace", e));
+    }
     // SAFETY: `rootfs` is a valid NUL-terminated path.
     if unsafe { libc::chdir(rootfs.as_ptr()) } != 0 {
         fail("enter rootfs", io::Error::last_os_error());
@@ -1570,13 +1622,27 @@ mod tests {
     /// namespace: not a relative one, a missing one or another namespace.
     #[test]
     fn only_a_network_namespace_path_is_joined() {
+        let open = |path: &str| super::open_ns_path(path, libc::CLONE_NEWNET);
         let me = std::fs::File::open("/proc/self/ns/net").unwrap();
-        let joined = super::open_netns_path("/proc/self/ns/net").unwrap();
+        let joined = open("/proc/self/ns/net").unwrap();
         assert_eq!(super::netns_inode(&joined), super::netns_inode(&me));
-        assert!(super::open_netns_path("proc/self/ns/net").unwrap_err().to_string().contains("not an absolute path"));
-        assert!(super::open_netns_path("/proc/self/ns/uts").unwrap_err().to_string().contains("not a network namespace"));
-        assert!(super::open_netns_path("/proc/self/status").unwrap_err().to_string().contains("not a network namespace"));
-        assert!(super::open_netns_path("/run/netns/kiri-test-missing").is_err());
+        assert!(open("proc/self/ns/net").unwrap_err().to_string().contains("not an absolute path"));
+        assert!(open("/proc/self/ns/uts").unwrap_err().to_string().contains("not a network namespace"));
+        assert!(open("/proc/self/status").unwrap_err().to_string().contains("not a network namespace"));
+        assert!(open("/run/netns/kiri-test-missing").is_err());
+    }
+
+    /// `--uts` and `--ipc ns:<path>` the same, each for its own type.
+    #[test]
+    fn only_a_uts_or_ipc_namespace_path_is_joined() {
+        let uts = |path: &str| super::open_ns_path(path, libc::CLONE_NEWUTS);
+        let ipc = |path: &str| super::open_ns_path(path, libc::CLONE_NEWIPC);
+        assert!(uts("/proc/self/ns/uts").is_ok());
+        assert!(ipc("/proc/self/ns/ipc").is_ok());
+        assert_eq!(uts("/proc/self/ns/ipc").unwrap_err().to_string(), "UTS namespace /proc/self/ns/ipc: not a UTS namespace");
+        assert_eq!(ipc("/proc/self/ns/net").unwrap_err().to_string(), "IPC namespace /proc/self/ns/net: not an IPC namespace");
+        assert!(uts("run/pod/uts").unwrap_err().to_string().contains("not an absolute path"));
+        assert!(ipc("/run/kiri-test-missing/ipc").unwrap_err().to_string().starts_with("IPC namespace /run/kiri-test-missing/ipc: "));
     }
 
     /// Only a pipe or a terminal the user doesn't own yet changes hands:
