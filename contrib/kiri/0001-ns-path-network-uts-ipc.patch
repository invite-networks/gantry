+/// `--network ns:<path>` (Podman's): join a network namespace made outside
+/// Kiri, such as `ip netns add pod` makes at /run/netns/pod. The container
+/// keeps its own hostname, /etc/hosts and resolv.conf (`--dns` and
+/// `--add-host` apply), as Podman's does. What would need Kiri to change
+/// that namespace is refused: published ports, a MAC address, links.
+fn ns_mode_allowed(body: &Value, path: &str) -> Result<(), Error> {
+    let host = &body["HostConfig"];
+    let given = |v: &Value| match v {
+        Value::Array(a) => !a.is_empty(),
+        Value::Object(o) => !o.is_empty(),
+        Value::String(s) => !s.is_empty(),
+        _ => false,
+    };
+    let conflict = |what: &str| Err(Error::BadRequest(format!("conflicting options: {what}")));
+    if !path.starts_with('/') || path.contains('\0') {
+        return Err(Error::BadRequest(
+            "Invalid network mode: invalid namespace format ns:<absolute path>".into(),
+        ));
+    }
+    if given(&host["Links"]) {
+        return conflict("ns type network can't be used with links");
+    }
+    if given(&body["MacAddress"]) {
+        return conflict("mac-address and the network mode");
+    }
+    if given(&host["PortBindings"]) || host["PublishAllPorts"].as_bool() == Some(true) {
+        return conflict("port publishing and the ns type network mode");
+    }
+    Ok(())
+}
+
+/// `--uts ns:<path>` and `--ipc ns:<path>` (Podman's): join a UTS or IPC
+/// namespace made outside Kiri, such as a pod's, kept as `ns:<path>`. In a
+/// joined UTS namespace the hostname is the namespace's: `Hostname` and
+/// `Domainname` are ignored rather than refused, so Docker clients that
+/// always send them still work. Any other mode is left as before (empty:
+/// a namespace of the container's own).
+fn ns_path_mode(host: &Value, key: &str) -> Result<String, Error> {
+    match host[key].as_str().unwrap_or_default().strip_prefix("ns:") {
+        None => Ok(String::new()),
+        Some(path) if path.starts_with('/') && !path.contains('\0') => Ok(format!("ns:{path}")),
+        Some(_) => Err(Error::BadRequest(format!(
+            "Invalid {key}: invalid namespace format ns:<absolute path>"
+        ))),
+    }
+}
