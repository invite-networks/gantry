+    /// `--network ns:<path>` takes only an absolute path to a network
+    /// namespace: not a relative one, a missing one or another namespace.
+    #[test]
+    fn only_a_network_namespace_path_is_joined() {
+        let open = |path: &str| super::open_ns_path(path, libc::CLONE_NEWNET);
+        let me = std::fs::File::open("/proc/self/ns/net").unwrap();
+        let joined = open("/proc/self/ns/net").unwrap();
+        assert_eq!(super::netns_inode(&joined), super::netns_inode(&me));
+        assert!(
+            open("proc/self/ns/net")
+                .unwrap_err()
+                .to_string()
+                .contains("not an absolute path")
+        );
+        assert!(
+            open("/proc/self/ns/uts")
+                .unwrap_err()
+                .to_string()
+                .contains("not a network namespace")
+        );
+        assert!(
+            open("/proc/self/status")
+                .unwrap_err()
+                .to_string()
+                .contains("not a network namespace")
+        );
+        assert!(open("/run/netns/kiri-test-missing").is_err());
+        // A FIFO or a device is refused without being opened: opening a FIFO
+        // with no writer would block the agent.
+        let dir = std::env::temp_dir().join(format!("kiri-ns-fifo-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let fifo = dir.join("fifo");
+        let c = std::ffi::CString::new(fifo.to_str().unwrap()).unwrap();
+        // SAFETY: a valid NUL-terminated path.
+        assert_eq!(unsafe { libc::mkfifo(c.as_ptr(), 0o600) }, 0);
+        let (tx, rx) = std::sync::mpsc::channel();
+        let p = fifo.to_str().unwrap().to_owned();
+        std::thread::spawn(move || {
+            let _ = tx.send(super::open_ns_path(&p, libc::CLONE_NEWNET).map(drop));
+        });
+        let got = rx
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("open_ns_path blocked on a FIFO");
+        assert!(
+            got.unwrap_err()
+                .to_string()
+                .contains("not a namespace file")
+        );
+        assert!(
+            open("/dev/null")
+                .unwrap_err()
+                .to_string()
+                .contains("not a namespace file")
+        );
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
