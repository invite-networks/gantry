+/// `--network`, `--uts` or `--ipc ns:<path>`: a namespace someone else made
+/// and keeps (`ip netns add`, a pod manager). It must be an absolute path to
+/// a namespace of that type (`CLONE_NEWNET`, `CLONE_NEWUTS`, `CLONE_NEWIPC`),
+/// checked here so a wrong one fails with its path rather than as the
+/// child's "join network container: Invalid argument".
+fn open_ns_path(path: &str, nstype: libc::c_int) -> io::Result<fs::File> {
+    const NS_GET_NSTYPE: libc::c_ulong = 0xb703; // _IO(0xb7, 0x3)
+    let (a, name) = match nstype {
+        libc::CLONE_NEWUTS => ("a", "UTS"),
+        libc::CLONE_NEWIPC => ("an", "IPC"),
+        _ => ("a", "network"),
+    };
+    let fail = |what: String| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("{name} namespace {path}: {what}"),
+        )
+    };
+    if !path.starts_with('/') {
+        return Err(fail("not an absolute path".into()));
+    }
+    let io_fail = |e: io::Error| io::Error::new(e.kind(), format!("{name} namespace {path}: {e}"));
+    // Namespace files are regular files (nsfs). Anything else is refused
+    // before it is opened: opening a FIFO blocks until a writer comes, and
+    // opening a device runs its driver.
+    if !fs::metadata(path).map_err(io_fail)?.is_file() {
+        return Err(fail("not a namespace file".into()));
+    }
+    // Non-blocking and checked again on the open file, in case the path was
+    // replaced between the two steps.
+    let f = {
+        use std::os::unix::fs::OpenOptionsExt;
+        fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NONBLOCK | libc::O_NOCTTY | libc::O_CLOEXEC)
+            .open(path)
+            .map_err(io_fail)?
+    };
+    if !f.metadata().map_err(io_fail)?.is_file() {
+        return Err(fail("not a namespace file".into()));
+    }
+    // SAFETY: an ioctl without arguments on a file we own.
+    let kind = unsafe { libc::ioctl(f.as_raw_fd(), NS_GET_NSTYPE as _) };
+    if kind != nstype {
+        return Err(fail(format!("not {a} {name} namespace")));
+    }
+    Ok(f)
+}
+
+/// The hostname set in a UTS namespace the container joins: /proc/sys
+/// shows the calling task's, so the agent steps in to read it and back out,
+/// as it does for sysctls.
+fn ns_hostname(ns: &fs::File) -> io::Result<String> {
+    let own = fs::File::open("/proc/self/ns/uts")?;
+    sys::setns(ns.as_raw_fd(), libc::CLONE_NEWUTS)?;
+    let name = fs::read_to_string("/proc/sys/kernel/hostname");
+    // Coming back must work, or the agent itself has the container's hostname.
+    if let Err(e) = sys::setns(own.as_raw_fd(), libc::CLONE_NEWUTS) {
+        eprintln!("kiri-init: cannot leave a container's UTS namespace: {e}");
+        std::process::abort();
+    }
+    Ok(name?.trim_end().to_owned())
+}
