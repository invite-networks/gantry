+/// `--network container:<id>` or `ns:<path>`: a network namespace that is
+/// not the container's own, so no endpoints, addresses or published ports.
+pub(super) fn shares_netns(mode: &str) -> bool {
+    mode.starts_with("container:") || mode.starts_with("ns:")
+}
