+/// `--network ns:<path>`: a network namespace someone else made and keeps
+/// (`ip netns add`, a pod manager). It must be an absolute path to a
+/// network namespace, checked here so a wrong one fails with its path
+/// rather than as the child's "join network container: Invalid argument".
+fn open_netns_path(path: &str) -> io::Result<fs::File> {
+    const NS_GET_NSTYPE: libc::c_ulong = 0xb703; // _IO(0xb7, 0x3)
+    let fail = |what: String| io::Error::new(io::ErrorKind::InvalidInput, format!("network namespace {path}: {what}"));
+    if !path.starts_with('/') {
+        return Err(fail("not an absolute path".into()));
+    }
+    let f = fs::File::open(path).map_err(|e| io::Error::new(e.kind(), format!("network namespace {path}: {e}")))?;
+    // SAFETY: an ioctl without arguments on a file we own.
+    let kind = unsafe { libc::ioctl(f.as_raw_fd(), NS_GET_NSTYPE as _) };
+    if kind != libc::CLONE_NEWNET {
+        return Err(fail("not a network namespace".into()));
+    }
+    Ok(f)
+}
+
 fn netns_inode(f: &fs::File) -> u64 {
     use std::os::unix::fs::MetadataExt;
     f.metadata().map_or(0, |m| m.ino())
