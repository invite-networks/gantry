#!/bin/sh
# Sets up the gantry group (people who may run gantry as root through
# sudo) and the gantry-remote account for remote control over SSH (see
# docs/runbooks/remote.md). The account cannot log in until a key is added
# to /etc/gantry/remote/authorized_keys.
set -e

if [ "$1" = configure ]; then
	if ! getent group gantry >/dev/null; then
		groupadd --system gantry
	fi
	if ! getent passwd gantry-remote >/dev/null; then
		if [ "$(getent passwd gantry | cut -d: -f6)" = /var/lib/gantry ]; then
			# Before 0.2.0 the remote control account was named gantry, with
			# gantry as its own group. Rename it in place, so its uid and
			# anything keyed to it survive, and give it its own group.
			getent group gantry-remote >/dev/null || groupadd --system gantry-remote
			if ! usermod -l gantry-remote -g gantry-remote gantry; then
				echo "gantry: could not rename the gantry account to gantry-remote (is it logged in?); run dpkg-reconfigure gantry once its sessions end" >&2
			fi
		else
			useradd --system --user-group --home-dir /var/lib/gantry \
				--shell /bin/sh --comment "Gantry remote control" gantry-remote
			# No password, but not locked: sshd without PAM refuses locked
			# accounts even for key logins.
			usermod -p '*' gantry-remote
		fi
	fi
	install -d -o root -g root -m 0755 /var/lib/gantry /etc/gantry /etc/gantry/remote
	# Local project storage, found through /mnt/* in project-dirs. Created
	# only when missing: an existing directory or mountpoint is left as it
	# is, and purge never removes it, since it holds data.
	if [ ! -e /mnt/container-local ]; then
		install -d -o root -g root -m 0755 /mnt/container-local
	fi
	if [ ! -e /etc/gantry/remote/authorized_keys ]; then
		install -o root -g root -m 0644 /dev/null /etc/gantry/remote/authorized_keys
	fi

	if command -v visudo >/dev/null 2>&1 &&
		! visudo -cqf /etc/sudoers.d/gantry; then
		echo "gantry: /etc/sudoers.d/gantry did not validate; remote control will not work" >&2
	fi
	if ! command -v sudo >/dev/null 2>&1; then
		echo "gantry: sudo is not installed; remote control over SSH needs it" >&2
	fi

	# Boot: one gantry-boot.service starts registered projects in pod
	# priority order.
	install -d -o root -g root -m 0700 /var/lib/gantry/boot
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload 2>/dev/null || true
	fi
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper enable gantry-boot.service >/dev/null 2>&1 || true
	elif [ -d /run/systemd/system ]; then
		systemctl enable gantry-boot.service >/dev/null 2>&1 || true
	fi

	# Health watcher. Enabled on first install; an existing disable (such
	# as gantry-agent taking over) is kept across upgrades.
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		if deb-systemd-helper --quiet was-enabled gantry-supervise.service; then
			deb-systemd-helper enable gantry-supervise.service >/dev/null 2>&1 || true
		else
			deb-systemd-helper update-state gantry-supervise.service >/dev/null 2>&1 || true
		fi
	fi
	if [ -d /run/systemd/system ] &&
		systemctl is-enabled --quiet gantry-supervise.service 2>/dev/null; then
		systemctl restart gantry-supervise.service >/dev/null 2>&1 || true
	fi

	# Pick up /etc/ssh/sshd_config.d/gantry.conf.
	if command -v sshd >/dev/null 2>&1; then
		if sshd -t 2>/dev/null; then
			if [ -d /run/systemd/system ]; then
				systemctl reload ssh.service 2>/dev/null ||
					systemctl reload sshd.service 2>/dev/null || true
			fi
		else
			echo "gantry: sshd -t failed; not reloading ssh. Check /etc/ssh/sshd_config.d/gantry.conf" >&2
		fi
	fi
fi
